# Load into your process environment; tsx does not auto-load this file.
# Demo binds loopback, uses volatile memory, no real model calls.
RUNTIME_MODE=demo
PORT=8787

# Configured mode requires database secrets plus TEXT and EXTRACT purposes.
# EMBED and IMAGE are optional capabilities; partial purpose configuration is invalid.
# Endpoint/key may be shared via OPENAI_* or overridden per purpose.
# Never use EXPO_PUBLIC_ prefixes for server secrets.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# DATA_MASTER_KEY=replace-with-base64-encoded-32-byte-secret
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_API_KEY=replace-with-server-only-secret
# TEXT_MODEL=your-text-model
# EXTRACT_MODEL=your-extraction-model
# EMBED_MODEL=your-1024-dimension-embedding-model
# IMAGE_MODEL=your-image-model
# ALLOWED_ORIGINS=https://your-client.example
# HOST=127.0.0.1

# Split providers (each falls back only to the corresponding legacy OPENAI_* value):
# TEXT_BASE_URL=https://api.deepseek.com
# TEXT_API_KEY=replace-with-deepseek-key
# TEXT_MODEL=deepseek-flash
# EXTRACT_BASE_URL=https://api.deepseek.com
# EXTRACT_API_KEY=replace-with-deepseek-key
# EXTRACT_MODEL=deepseek-flash
# EMBED_BASE_URL=https://your-embedding-provider.example/v1
# EMBED_API_KEY=replace-with-embedding-key
# IMAGE_BASE_URL=https://your-image-provider.example/v1
# IMAGE_API_KEY=replace-with-image-key
# deepseek-flash is a text model; do not use it as EMBED_MODEL or IMAGE_MODEL.
# If EMBED_* is absent, retrieval/chat fails closed with 503; no fake vectors or silent fallback.
# If IMAGE_* is absent, image candidates return 503 before enqueue and the worker skips image claims.
# Current local verification: real DeepSeek TEXT/EXTRACT calls passed; IMAGE remains unconfigured.
