# Copy into apps/mobile/.env; Expo public values are bundled into the client.
# This URL is the Runtime origin; do not append /api.
EXPO_PUBLIC_MODE=demo
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
# Configured mode only: public Supabase anon/publishable key, NEVER service role.
# EXPO_PUBLIC_MODE=configured
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
